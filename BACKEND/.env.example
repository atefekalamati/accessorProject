# Copy this file to .env and replace every placeholder before deployment.
# Used by host-side commands (uvicorn, alembic); docker compose overrides it for the api container.
# For host runs use 127.0.0.1 (not localhost: ~5x slower on Windows) and DB_HOST_PORT,
# e.g. ...@127.0.0.1:5432/project_ak
DATABASE_URL=postgresql+asyncpg://project_ak:change-me@postgres:5432/project_ak
JWT_SECRET=replace-with-at-least-32-random-characters
ENVIRONMENT=development
# Frontend origins (comma-separated); cookies are sent to them. Required in production, no "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mock OTP is development/test-only.
OTP_MOCK_ENABLED=true
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=120
# HMAC key for stored OTP hashes (min 32 chars); required in production, separate from JWT_SECRET.
OTP_HASH_SECRET=replace-with-another-32-plus-random-characters
# OTP request limits (rolling one-hour window); exceeding any returns 429 OTP_RATE_LIMITED.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=60
OTP_MAX_GLOBAL_PER_HOUR=500
OTP_MAX_ATTEMPTS=5
# Access JWT lifetime (returned in the body) and refresh token lifetime (HttpOnly cookie).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Media storage (CAT-05): local files under MEDIA_ROOT, served from MEDIA_PUBLIC_BASE_URL.
# The base URL's host must be listed in MEDIA_ALLOWED_HOSTS (comma-separated); https in production.
MEDIA_STORAGE=local
MEDIA_ROOT=var/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/media
MEDIA_ALLOWED_HOSTS=localhost
# Seconds between sweeps of expired stock reservations (INV-06); 0 turns the sweep off.
RESERVATION_SWEEP_SECONDS=60
# Failed discount-code attempts (rolling window in seconds); reaching a cap returns 429.
DISCOUNT_ATTEMPT_WINDOW_SECONDS=900
DISCOUNT_MAX_FAILED_PER_OWNER=10
DISCOUNT_MAX_FAILED_PER_IP=30
DISCOUNT_MAX_FAILED_GLOBAL=10000

POSTGRES_DB=project_ak
POSTGRES_USER=project_ak
POSTGRES_PASSWORD=change-me
LOG_LEVEL=INFO

# Host ports published by docker compose; change them if 5432/8000 are already taken.
DB_HOST_PORT=5432
API_HOST_PORT=8000
# Host port of the disposable postgres-test service (docker compose --profile test).
TEST_DB_HOST_PORT=55432

# Optional PyPI mirror for the api image build (default: official PyPI); no credentials here.
PIP_INDEX_URL=https://pypi.org/simple
# Tests only (read by tests/conftest.py, not by the app); the database name must end in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@127.0.0.1:55432/project_ak_test
# Payments (PAY-01..06). fake is refused in production.
PAYMENT_GATEWAY=fake
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback
PAYMENT_GATEWAY_TIMEOUT_SECONDS=10
PAYMENT_RECONCILE_SECONDS=60
PAYMENT_PENDING_STALE_SECONDS=300
PAYMENT_MIN_REMAINING_SECONDS=60
PAYMENT_CALLBACK_WINDOW_SECONDS=60
PAYMENT_CALLBACK_MAX_PER_IP=30
PAYMENT_EVENT_RETENTION_DAYS=90
PAYMENT_FAKE_SESSION_SECONDS=900
# Product cards mark products created within this many days as new (D42).
PRODUCT_NEW_DAYS=30
