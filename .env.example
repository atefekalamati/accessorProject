# Copy this file to .env and replace every placeholder before deployment.
# Used by host-side commands (uvicorn, alembic); docker compose overrides it for the api container.
# For host runs use localhost and DB_HOST_PORT, e.g. ...@localhost:5432/project_ak
DATABASE_URL=postgresql+asyncpg://project_ak:change-me@postgres:5432/project_ak
JWT_SECRET=replace-with-at-least-32-random-characters
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mock OTP is development/test-only.
OTP_MOCK_ENABLED=true
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=120
# HMAC key for stored OTP hashes (min 32 chars); required in production, separate from JWT_SECRET.
OTP_HASH_SECRET=replace-with-another-32-plus-random-characters
# OTP request limits (rolling one-hour window); exceeding any returns 429 OTP_RATE_LIMITED.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=60
OTP_MAX_GLOBAL_PER_HOUR=500
OTP_MAX_ATTEMPTS=5
# Access JWT lifetime (returned in the body) and refresh token lifetime (HttpOnly cookie).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

POSTGRES_DB=project_ak
POSTGRES_USER=project_ak
POSTGRES_PASSWORD=change-me
LOG_LEVEL=INFO

# Host ports published by docker compose; change them if 5432/8000 are already taken.
DB_HOST_PORT=5432
API_HOST_PORT=8000
# Host port of the disposable postgres-test service (docker compose --profile test).
TEST_DB_HOST_PORT=55432

# Optional PyPI mirror for the api image build (default: official PyPI); no credentials here.
PIP_INDEX_URL=https://pypi.org/simple
