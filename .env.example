# Copy this file to .env and replace every placeholder before deployment.
# Used by host-side commands (uvicorn, alembic); docker compose overrides it for the api container.
# For host runs use localhost and DB_HOST_PORT, e.g. ...@localhost:5432/project_ak
DATABASE_URL=postgresql+asyncpg://project_ak:change-me@postgres:5432/project_ak
JWT_SECRET=replace-with-at-least-32-random-characters
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mock OTP is development/test-only. Authentication is implemented in stage 2.
OTP_MOCK_ENABLED=true
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=120

POSTGRES_DB=project_ak
POSTGRES_USER=project_ak
POSTGRES_PASSWORD=change-me
LOG_LEVEL=INFO

# Host ports published by docker compose; change them if 5432/8000 are already taken.
DB_HOST_PORT=5432
API_HOST_PORT=8000

# Optional PyPI mirror for the api image build (default: official PyPI); no credentials here.
PIP_INDEX_URL=https://pypi.org/simple
