{
  "name": "kalea-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen:api": "openapi-typescript ../BACKEND/docs/api/versions/openapi-phase-5.json -o src/api/schema.gen.ts",
    "check:api": "node scripts/check-api-drift.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@tanstack/react-query": "5.108.2",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
