# Server-only settings. Nothing here reaches the browser (no NEXT_PUBLIC_ variables).

# Backend origin the same-origin proxy (/api/v1/*) and server rendering talk to.
API_ORIGIN=http://localhost:8000

# Number of trusted reverse proxies in front of this server that append to X-Forwarded-For.
# 0 = no trusted proxy: no client IP is forwarded, so the API sees this server's address for
# every visitor (safe, but one shared rate-limit bucket). Production sits behind an ingress
# that appends the peer address and sets this to its hop count (OPS-04).
TRUSTED_PROXY_HOPS=0

# Development and staging only: shows /dev/fake-gateway/[reference] for the fake gateway.
FAKE_GATEWAY_PAGE=0
